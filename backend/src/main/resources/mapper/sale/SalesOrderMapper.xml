<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smms.sale.mapper.SalesOrderMapper">

    <!-- 当日该收银台最大单号（BR-SALE-02）：前缀范围降序取第一条并加行锁，
         串行化同收银台取号；uk_so_no 兜底防重 -->
    <select id="selectLastOrderNoForUpdate" resultType="java.lang.String">
        SELECT order_no
        FROM sales_order
        WHERE order_no LIKE CONCAT(#{prefix}, '%')
        ORDER BY order_no DESC
        LIMIT 1
        FOR UPDATE
    </select>
</mapper>
